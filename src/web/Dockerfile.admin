# Build context: src/web. Admin is a client-only SPA (plan.md: no SSR/SEO requirements for the
# back office), so unlike the storefront it's just static files behind nginx.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# fonts:false (container configuration): the build container may have no internet to inline Google Fonts; the browser loads them at run time.
RUN npx ng build admin --configuration container

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist/admin/browser /usr/share/nginx/html
# nginx substitutes ${API_UPSTREAM} (and only the variables that are set) into this template at container start.
COPY nginx.admin.conf /etc/nginx/templates/default.conf.template
COPY docker-entrypoint-env.sh /docker-entrypoint.d/30-romp-env.sh
RUN chmod +x /docker-entrypoint.d/30-romp-env.sh
ENV API_BASE_URL=""
ENV API_UPSTREAM=http://api:8080
EXPOSE 80
