# Build context: src/web. Admin is a client-only SPA (plan.md: no SSR/SEO requirements for the
# back office), so unlike the storefront it's just static files behind nginx.
FROM node:26-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx ng build admin

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist/admin/browser /usr/share/nginx/html
COPY nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint-env.sh /docker-entrypoint.d/30-romp-env.sh
RUN chmod +x /docker-entrypoint.d/30-romp-env.sh
ENV API_BASE_URL=http://localhost:8080
EXPOSE 80
