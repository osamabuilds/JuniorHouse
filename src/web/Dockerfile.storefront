# Build context: src/web
FROM node:26-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx ng build storefront

FROM node:26-alpine AS runtime
WORKDIR /app
# Angular SSR's SSRF guard rejects any Host header not in this allowlist (comma-separated).
# Override per environment (e.g. the production domain behind Cloudflare) via docker-compose.
ENV NODE_ENV=production PORT=4000 NG_ALLOWED_HOSTS=localhost
COPY --from=build /app/dist/storefront ./dist/storefront
EXPOSE 4000
USER node
CMD ["node", "dist/storefront/server/server.mjs"]
